{
  "name": "b2b-ai-chatbot-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Multi-tenant B2B AI Chatbot SaaS Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:widget": "npm run build --workspace=@b2b-ai-chatbot/widget && node -e \"import('fs').then(fs=>fs.copyFileSync('apps/widget/dist/widget.iife.js','apps/admin/public/widget.iife.js'))\"",
    "build": "npm run build --workspace=@b2b-ai-chatbot/widget && node -e \"import('fs').then(fs=>fs.copyFileSync('apps/widget/dist/widget.iife.js','apps/admin/public/widget.iife.js'))\" && npm run build --workspace=@b2b-ai-chatbot/admin",
    "dev": "npm run dev --workspaces --if-present",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "test": "node scripts/tests/test-schemas.js && node scripts/tests/test-api-imports.cjs",
    "test:secrets": "node scripts/ops/check-no-secrets.cjs",
    "test:api": "node scripts/tests/test-api-imports.cjs",
    "test:pipeline": "node scripts/tests/test-pipeline.js",
    "test:rag": "node scripts/tests/test-rag-search.js",
    "test:schemas": "node scripts/tests/test-schemas.js",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "reingest:delafontaine": "node scripts/adhoc/reingest-delafontaine.mjs",
    "setup:stripe": "node scripts/ops/setup-stripe.mjs",
    "setup:supabase": "node scripts/ops/setup-supabase.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.8",
    "resend": "^6.20.0",
    "stripe": "^22.6.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
