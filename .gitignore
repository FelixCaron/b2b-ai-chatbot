# Dependencies
node_modules/

# Next.js / Vite build outputs
.next/
dist/
build/
out/

# Environment files and secrets
.env
.env.local
.env.*.local

# Vercel & temp files
.vercel/
.temp/

# Logs
*.log

# Playwright E2E test artifacts
/test-results/
/playwright-report/
/playwright/.cache/

# Terraform — state and credentials never; the provider lock file always,
# so every machine and every CI run resolves the same provider versions.
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.*
infra/terraform/**/terraform.tfvars

# Claude Code local tooling scratch space (agent worktrees, session state)
/.claude/
