# Supabase project URL — safe to expose in the Vite bundle (it's not a
# secret), and used server-side too. One var, no separate server-only name.
VITE_SUPABASE_URL=https://your-project.supabase.co

# Use Supabase's new API keys, not the legacy anon/service_role JWTs —
# Project Settings -> API Keys (not the "Legacy API keys" tab).
# Publishable key (sb_publishable_...) — safe to expose in the Vite bundle.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# Secret key (sb_secret_...) — server-side only (set in Vercel), never
# prefix this one with VITE_ or anywhere that ships to the browser. Full
# value is only shown once when a key is created; if you've lost it,
# generate a new one rather than trying to recover the old value.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
OPENROUTER_API_KEY=your-openrouter-api-key
STRIPE_SECRET_KEY=sk_test_or_live_key
STRIPE_WEBHOOK_SECRET=whsec_value
STRIPE_PRICE_ID_STARTER=price_value
STRIPE_PRICE_ID_PRO=price_value
VITE_APP_URL=https://your-admin-domain.example
ADMIN_ALLOWED_ORIGINS=https://your-admin-domain.example

# Resend Email
RESEND_API_KEY=re_123456789
ADMIN_EMAIL=admin@example.com

# LLM Models
DEFAULT_MODEL=openai/gpt-5.6-luna
PREMIUM_MODEL=anthropic/claude-3.5-sonnet

