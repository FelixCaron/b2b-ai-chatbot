# Every variable the code actually reads, and nothing else. A name that is not
# in here is not read anywhere — see docs/DEPLOYMENT.md for which environment
# supplies which value in a real deployment (Terraform sets them per
# environment; this file is for local development).

# --- Supabase ---------------------------------------------------------------
# Project URL — not a secret, and read both server-side (process.env, in
# dorafi/admin/api/**) and client-side (import.meta.env). One var, no separate
# server-only name for it.
VITE_SUPABASE_URL=https://your-project.supabase.co

# Use Supabase's new API keys, not the legacy anon/service_role JWTs —
# Project Settings -> API Keys (not the "Legacy API keys" tab).
# Publishable key — safe to expose in the Vite bundle.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
# Secret key — server-side only. Never prefix this one with VITE_. Its full
# value is shown once, at creation; if lost, generate a new one.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# --- The app's own public URL ------------------------------------------------
# Where this deployment is served. Stripe builds its success/cancel redirects
# from it, and OpenRouter is told about it for attribution. Getting this wrong
# in a preview environment sends checkout back to production.
VITE_APP_URL=https://dorafi.logafi.com

# Which deployment of the product the STAFF console should link to (its niche
# landing pages). The staff console is a separate project on a separate domain,
# so it cannot infer this from its own origin. Defaults to production.
VITE_PUBLIC_APP_URL=https://dorafi.logafi.com

# --- LLM and content extraction ----------------------------------------------
OPENROUTER_API_KEY=your-openrouter-api-key
JINA_API_KEY=jina_your-key          # Jina Reader (page fetch) + embeddings
DEFAULT_MODEL=openai/gpt-5.6-luna
PREMIUM_MODEL=anthropic/claude-sonnet-5

# --- Stripe ------------------------------------------------------------------
# The price IDs are per Stripe mode: test-mode and live-mode prices are
# different objects. Run `npm run setup:stripe` against the mode you want and
# use the IDs it prints. STRIPE_WEBHOOK_SECRET belongs to one specific webhook
# endpoint — each environment registers its own and gets its own secret.
STRIPE_SECRET_KEY=sk_test_or_live_key
STRIPE_WEBHOOK_SECRET=whsec_value
STRIPE_PRICE_ID_BASIC=price_value
STRIPE_PRICE_ID_PRO=price_value
STRIPE_PRICE_ID_PREMIUM=price_value

# --- Transactional email (Resend) ---------------------------------------------
RESEND_API_KEY=re_123456789
ADMIN_EMAIL=admin@example.com               # where platform alerts go
SYSTEM_EMAIL_FROM=noreply@dorafi.logafi.com # the From: address; its domain must
                                            # be verified in Resend to deliver

# --- Cloudflare Turnstile (invisible captcha) ---------------------------------
# Guards the two onboarding endpoints that run before a site exists and so
# cannot be protected by tenant ownership (crawler/crawl, chat/theme).
# The values below are Cloudflare's documented always-pass test pair — correct
# for local development and for preview, wrong for production. Note that with
# TURNSTILE_SECRET_KEY *unset* the server fails open, which is why the test
# secret is set explicitly rather than left blank.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Local development only ---------------------------------------------------
# TEST_MODE=true short-circuits the outbound network calls in the crawler and
# theme extraction. Never set it in a deployed environment.
# TEST_MODE=false
