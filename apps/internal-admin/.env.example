# Same Supabase project as the main product — staff sign in with their
# normal Supabase Auth account. Project URL is safe to expose in the Vite
# bundle and used server-side too; one var, no separate server-only name.
VITE_SUPABASE_URL=https://your-project.supabase.co

# Use the new-format API keys (Project Settings -> API Keys), not the legacy
# anon/service_role JWTs.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# Secret key — server-side only (set in this app's own Vercel project),
# never prefix with VITE_. Only shown in full once, at creation time.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# The product deployment this console calls when staff re-index a customer's
# pages on their request (api/staff/knowledge/reindex.js). That crawl runs in
# the main project, not this one — the console forwards the staff member's own
# token to it. Leave it unset and re-indexing reports that it is unconfigured;
# nothing else in the console depends on it.
APP_API_BASE_URL=https://app.your-domain.com
