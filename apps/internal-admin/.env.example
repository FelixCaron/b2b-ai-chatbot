# Client-side (safe to expose in the Vite bundle) — same Supabase project as
# the main product, since staff sign in with their normal Supabase Auth account.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side (set in this app's own Vercel project; never prefix with VITE_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
